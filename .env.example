# OrzChat
# Leave ORZCHAT_ROOM empty to join the public matchmaking queue.
ORZCHAT_ROOM=
# ORZCHAT_SERVER_URL=wss://ws.orzchat.com:443/
# ORZCHAT_PROXY=http://127.0.0.1:7890

# OpenAI-compatible Chat Completions provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_PROXY=http://127.0.0.1:7890
# OPENAI_TEMPERATURE=0.8
# OPENAI_MAX_TOKENS=
# OPENAI_TIMEOUT=60
# OPENAI_EXTRA_BODY={}

# Bot behaviour
# BOT_SYSTEM_PROMPT=You are a friendly anonymous chat partner.
# BOT_HELLO_MESSAGE=Hi! What's on your mind?
# BOT_MAX_HISTORY=10
# BOT_MAX_REPLY_CHARS=300
# BOT_DEBOUNCE_SECONDS=0.5
# BOT_MAX_REPLIES_PER_CHAT=100
# BOT_LOG_LEVEL=INFO
# BOT_LOG_MESSAGES=true
# BOT_DRY_RUN=false
# BOT_ONCE=false
